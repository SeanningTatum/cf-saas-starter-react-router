{
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    }
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "auth-skills@better-auth-agent-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "impeccable@impeccable": true,
    "taste-skill@taste-skill": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)"
    ]
  },
  "skillOverrides": {
    "embedded-captions": "off",
    "faceless-explainer": "off",
    "figma": "off",
    "general-video": "off",
    "hyperframes": "off",
    "hyperframes-animation": "off",
    "hyperframes-cli": "off",
    "hyperframes-core": "off",
    "hyperframes-creative": "off",
    "hyperframes-keyframes": "off",
    "hyperframes-registry": "off",
    "media-use": "off",
    "motion-graphics": "off",
    "music-to-video": "off",
    "pr-to-video": "off",
    "product-launch-video": "off",
    "recipe-box": "off",
    "reel-to-recipe": "off",
    "remotion-to-hyperframes": "off",
    "slideshow": "off",
    "talking-head-recut": "off",
    "video-watcher": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\" 2>&1 || true"
          }
        ]
      }
    ]
  }
}
