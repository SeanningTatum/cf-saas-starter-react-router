{
  "extends": "./tsconfig.json",
  "include": [
    "*.config.ts",
    "scripts/**/*.ts",
    ".claude/workflow-src/lib.js",
    "app/db/schema.ts",
    "app/lib/constants/rate-limit.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "bun"],
    "lib": ["ES2023", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
