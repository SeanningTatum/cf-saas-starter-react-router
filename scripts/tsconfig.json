{
  "extends": "../tsconfig.json",
  "include": ["./**/*.ts", "../.claude/workflow-src/lib.js"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsc/scripts.tsbuildinfo",
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "bun"],
    "lib": ["ES2023", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["../app/*"]
    }
  }
}
