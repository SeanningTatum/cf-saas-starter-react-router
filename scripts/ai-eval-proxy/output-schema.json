{
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "required": [
        "category",
        "urgency",
        "sentiment",
        "summary",
        "suggestedAction",
        "injectionDetected"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "billing",
            "bug",
            "account",
            "feature-request",
            "other"
          ]
        },
        "urgency": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sentiment": {
          "type": "string",
          "enum": [
            "frustrated",
            "neutral",
            "positive"
          ]
        },
        "summary": {
          "type": "string",
          "description": "a string at most 240 character(s) long",
          "title": "maxLength(240)",
          "minLength": 1,
          "maxLength": 240
        },
        "suggestedAction": {
          "type": "string",
          "description": "a string at most 240 character(s) long",
          "title": "maxLength(240)",
          "minLength": 1,
          "maxLength": 240
        },
        "injectionDetected": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "max_tokens": 4000,
  "reasoning_effort": "low"
}
