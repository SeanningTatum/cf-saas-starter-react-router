.DS_Store
.env
/node_modules/
*.tsbuildinfo

# React Router
/.react-router/
/build/

# Cloudflare
.mf
.wrangler
.dev.vars*
worker-configuration.d.ts

!.dev.vars.example
!.env.example
!.cursor/mcp.template.json

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/**/*.png

# Manual Playwright MCP screenshots (transient, not checked in)
/.playwright-mcp/
/*-light.png
/*-dark.png
/*-user.png
/*-v2.png
/home-*.png
/login-*.png
/signup-*.png
/dashboard-*.png

# Claude Code (per-machine config + secrets)
.claude/settings.local.json
.claude/.credentials*
.claude/state/
.claude/cache/

# Editor agent caches
.cursor/

# Agent skills — restored from skills-lock.json by scripts/restore-skills.sh, which also links them
# into .claude/skills/; only the lock is committed
/.agents/
/.claude/skills/

# Design skill scratch output and per-machine config; .impeccable/config.json stays shared
.taste-skill/
.impeccable/config.local.json

# Kimi Code — only the sub-agent symlink is shared; the rest is per-machine state
/.kimi-code/*
!/.kimi-code/agents

# feature-verifier throwaway Playwright scripts (see .claude/agents/feature-verifier.md)
tmp/

# feature-verifier screenshots and verdicts
/.verify/

# lavish review pages written outside .verify/
/.lavish/
