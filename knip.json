{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/ci/*.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "workers/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ],
  "ignore": [
    "app/components/ui/**"
  ],
  "ignoreExportsUsedInFile": false,
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ]
}
