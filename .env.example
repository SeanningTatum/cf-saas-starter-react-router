# Template for `.env`. `bun run setup` (scripts/first-time-setup.ts) writes
# this file for you on first run — only fill it in by hand if you're
# skipping the setup wizard.

# Authentication secrets
# At least 32 characters: paste the output of `openssl rand -hex 32`.
BETTER_AUTH_SECRET=paste-openssl-rand-hex-32
# BETTER_AUTH_URL is required outside a dev build, AUTH_TRUSTED_ORIGINS is
# optional; .dev.vars.example explains both.
# BETTER_AUTH_URL=http://localhost:4173
# AUTH_TRUSTED_ORIGINS=https://*-my-app-preview.my-team.workers.dev

# Public variables
VITE_AUTH_URL=http://localhost:5173
